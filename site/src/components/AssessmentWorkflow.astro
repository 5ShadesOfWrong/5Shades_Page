---
/**
 * AssessmentWorkflow.astro — §4 the 4-step checklist (DESIGN_PLAN §4)
 * -------------------------------------------------------------------
 * Sticky compact PipelineDiagram on one side, the four assessment steps
 * (0–3) scrolling on the other — the paper's reminder slide (p.12/p.20)
 * turned into a walkthrough.
 *
 * Security: typed JSON data, auto-escaped.
 */
import workflow from '../data/workflow.json';
import PipelineDiagram from './PipelineDiagram.astro';
import type { WorkflowData } from '../schemas/schemas';

const data = workflow as unknown as WorkflowData;
const steps = data.steps;
const intro = data.intro;

// Map each step to the diagram highlight (steps 1–3 carry a lens field).
const highlightFor = (step: Step) =>
	(step.lens as 'coherence' | 'validity' | 'faithfulness' | undefined) ?? 'none';
---

<section id="workflow" class="section" aria-labelledby="workflow-title">
	<div class="container">
		<h2 id="workflow-title">Assessment Workflow</h2>
		<p class="intro">{intro}</p>

		<div class="workflow-grid">
			<!-- Sticky diagram column -->
			<div class="diagram-col" aria-hidden="true">
				<div class="sticky">
					<PipelineDiagram compact showLabels={false} id="workflow-diagram" />
				</div>
			</div>

			<!-- Steps column -->
			<ol class="steps" role="list">
				{
					steps.map((step) => (
						<li class="step" data-lens={step.lens ?? 'context'}>
							<div class="step-marker">
								<span class="step-number">{step.number}</span>
							</div>
							<div class="step-body">
								<h3>{step.title}</h3>
								<p class="step-question">{step.question}</p>
								<ul>
									{step.details.map((detail) => (
										<li>{detail}</li>
									))}
								</ul>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</div>
</section>

<style>
	.intro {
		margin-top: var(--space-4);
		font-size: var(--text-lg);
		color: var(--color-text-muted);
		max-width: 56ch;
	}

	.workflow-grid {
		margin-top: var(--space-8);
		display: grid;
		grid-template-columns: minmax(14rem, 22rem) 1fr;
		gap: var(--space-12);
		align-items: start;
	}

	/* ---- Sticky diagram ---- */
	.sticky {
		position: sticky;
		top: 30vh;
	}

	/* ---- Steps ---- */
	.steps {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-12);
	}

	.step {
		display: flex;
		gap: var(--space-6);
		scroll-margin-top: 30vh;
	}

	.step-marker {
		flex-shrink: 0;
	}

	.step-number {
		display: grid;
		place-items: center;
		width: 3rem;
		height: 3rem;
		border-radius: 50%;
		border: 2px solid var(--color-border);
		font-family: var(--font-mono);
		font-size: var(--text-xl);
		color: var(--color-text-muted);
		transition: border-color var(--duration-normal) var(--ease-out),
			color var(--duration-normal) var(--ease-out);
	}

	/* Lens-colored markers (matches PipelineDiagram highlight colors) */
	.step[data-lens='coherence'] .step-number {
		border-color: var(--color-model);
		color: var(--color-model);
	}
	.step[data-lens='validity'] .step-number {
		border-color: var(--color-positive);
		color: var(--color-positive);
	}
	.step[data-lens='faithfulness'] .step-number {
		border-color: var(--color-negative);
		color: var(--color-negative);
	}

	.step-body h3 {
		font-size: var(--text-xl);
	}

	.step-question {
		margin-top: var(--space-2);
		color: var(--color-text);
		font-weight: 500;
	}

	.step-body ul {
		margin-top: var(--space-3);
		padding-left: var(--space-5);
		display: grid;
		gap: var(--space-1);
		color: var(--color-text-muted);
		font-size: var(--text-sm);
	}

	/* ---- Mobile: diagram flows inline, not sticky ---- */
	@media (max-width: 900px) {
		.workflow-grid {
			grid-template-columns: 1fr;
			gap: var(--space-8);
		}

		.sticky {
			position: static;
		}

		.diagram-col {
			display: flex;
			justify-content: center;
		}
	}
</style>
