---
/**
 * PipelineFlow.astro — the paper's central diagram, rebuilt in HTML/CSS
 * (user review 2026-10-21: match the paper figure — three nodes with icons,
 * labeled arrows, numbered callout boxes, and lightning stickers).
 *
 * Layout (mirrors the paper figure):
 *   - Top: green callout "1. What the explainee sees"
 *   - Middle row: Ground Truth —(Machine Learning)→ Explanation ←(XAI Method)— AI Model
 *   - Stickers: 2. Validity (under the left arrow), 1. Coherence (above the
 *     chart, with the loop arrow), 3. Faithfulness (under the right arrow)
 *   - Left: purple callout "2. Ground truth" · Right: blue callout "3. Actual model behavior"
 *
 * Security: purely static markup; no dynamic content is injected.
 */
---

<figure class="flow">
	{/* ---- 1. What the explainee sees (top, green) ---- */}
	<div class="callout callout-seen">
		<h3>1. What the explainee sees</h3>
		<ul>
			<li><strong>Output of the AI model:</strong> What does the AI model show as the output?</li>
			<li><strong>Explanation:</strong> What does the XAI method show as an explanation?</li>
		</ul>
	</div>

	{/* ---- 2. Ground truth (left, purple) ---- */}
	<div class="callout callout-truth">
		<h3>2. Ground truth</h3>
		<ul>
			<li><strong>Outcome:</strong> What would be the true prediction?</li>
			<li><strong>Premise:</strong> What are the causal assumptions for predictions?</li>
		</ul>
	</div>

	{/* ---- Central flow: Ground Truth → Explanation ← AI Model ---- */}
	<div class="track">
		<div class="node">
			<svg class="icon" viewBox="0 0 48 48" aria-hidden="true">
				<circle cx="24" cy="24" r="18" />
				<ellipse cx="24" cy="24" rx="8" ry="18" />
				<line x1="6" y1="24" x2="42" y2="24" />
			</svg>
			<span class="node-label">Ground Truth</span>
		</div>

		<div class="arrow">
			<span class="arrow-name">Machine Learning</span>
			<svg class="line" viewBox="0 0 120 14" preserveAspectRatio="none" aria-hidden="true">
				<line x1="2" y1="7" x2="106" y2="7" class="shaft" vector-effect="non-scaling-stroke" />
				<polygon points="106,1.5 120,7 106,12.5" class="head" />
			</svg>
			<span class="sticker sticker-validity">
				<svg class="bolt" viewBox="0 0 12 16" aria-hidden="true"><path d="M7.5 0 L1 9 H4.5 L3.5 16 L11 6 H6.5 Z" /></svg>
				2. Validity
			</span>
		</div>

		<div class="node node-chart">
			<span class="sticker sticker-coherence">
				<svg class="loop" viewBox="0 0 20 20" aria-hidden="true">
					<path d="M17 10 a7 7 0 1 1 -3.2 -5.9" />
					<polygon points="12.5,1.5 18.5,4.5 13,8.5" />
				</svg>
				1. Coherence
				<svg class="bolt" viewBox="0 0 12 16" aria-hidden="true"><path d="M7.5 0 L1 9 H4.5 L3.5 16 L11 6 H6.5 Z" /></svg>
			</span>
			<svg class="icon" viewBox="0 0 48 48" aria-hidden="true">
				<rect x="6" y="10" width="7" height="30" class="bar" />
				<rect x="17" y="18" width="7" height="22" class="bar" />
				<rect x="28" y="26" width="7" height="14" class="bar" />
				<rect x="39" y="32" width="7" height="8" class="bar" />
			</svg>
			<span class="node-label">Explanation</span>
		</div>

		<div class="arrow">
			<span class="arrow-name">XAI Method</span>
			<svg class="line" viewBox="0 0 120 14" preserveAspectRatio="none" aria-hidden="true">
				<line x1="14" y1="7" x2="118" y2="7" class="shaft" vector-effect="non-scaling-stroke" />
				<polygon points="14,1.5 0,7 14,12.5" class="head" />
			</svg>
			<span class="sticker sticker-faithfulness">
				<svg class="bolt" viewBox="0 0 12 16" aria-hidden="true"><path d="M7.5 0 L1 9 H4.5 L3.5 16 L11 6 H6.5 Z" /></svg>
				3. Faithfulness
			</span>
		</div>

		<div class="node">
			<svg class="icon" viewBox="0 0 48 48" aria-hidden="true">
				<rect x="12" y="12" width="24" height="24" rx="4" />
				<text x="24" y="29" text-anchor="middle" class="chip-text">AI</text>
				<line x1="17" y1="5" x2="17" y2="12" /><line x1="24" y1="5" x2="24" y2="12" /><line x1="31" y1="5" x2="31" y2="12" />
				<line x1="17" y1="36" x2="17" y2="43" /><line x1="24" y1="36" x2="24" y2="43" /><line x1="31" y1="36" x2="31" y2="43" />
				<line x1="5" y1="17" x2="12" y2="17" /><line x1="5" y1="24" x2="12" y2="24" /><line x1="5" y1="31" x2="12" y2="31" />
				<line x1="36" y1="17" x2="43" y2="17" /><line x1="36" y1="24" x2="43" y2="24" /><line x1="36" y1="31" x2="43" y2="31" />
			</svg>
			<span class="node-label">AI Model</span>
		</div>
	</div>

	{/* ---- 3. Actual model behavior (right, blue) ---- */}
	<div class="callout callout-behavior">
		<h3>3. Actual model behavior</h3>
		<p>How did the model actually come to this output?</p>
	</div>
</figure>

<style>
	.flow {
		margin: 0;
		display: grid;
		grid-template-columns: minmax(12rem, 15rem) 1fr minmax(12rem, 15rem);
		gap: var(--space-6);
		align-items: center;
	}

	/* ---- Callout boxes (numbered, color-coded like the paper) ---- */
	.callout {
		background: var(--color-bg-raised);
		border: 2px solid var(--color-border);
		border-radius: var(--radius-md);
		/* Generous padding so the border breathes around the text (user review:
		   the box lines sat too close to the text). */
		padding: var(--space-6);
		font-size: var(--text-sm);
	}

	.callout h3 {
		margin: 0 0 var(--space-2);
		font-family: var(--font-body);
		font-size: var(--text-sm);
		font-weight: 700;
	}

	.callout ul {
		margin: 0;
		padding-left: var(--space-4);
		display: grid;
		gap: var(--space-2);
		color: var(--color-text-muted);
	}

	.callout p {
		margin: 0;
		color: var(--color-text-muted);
	}

	.callout strong {
		color: var(--color-text);
	}

	.callout-seen {
		grid-column: 2;
		grid-row: 1;
		justify-self: center;
		margin-bottom: var(--space-8);
		border-color: var(--color-positive);
	}

	.callout-seen h3 {
		color: var(--color-positive);
	}

	.callout-truth {
		grid-column: 1;
		grid-row: 2;
		border-color: var(--color-model);
	}

	.callout-truth h3 {
		color: var(--color-model);
	}

	.callout-behavior {
		grid-column: 3;
		grid-row: 2;
		border-color: var(--color-link);
	}

	.callout-behavior h3 {
		color: var(--color-link);
	}

	/* ---- Central flow ---- */
	.track {
		grid-column: 2;
		grid-row: 2;
		display: flex;
		align-items: center;
		gap: var(--space-4);
	}

	.node {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-2);
		text-align: center;
	}

	.icon {
		width: 52px;
		height: 52px;
		fill: none;
		stroke: var(--color-text);
		stroke-width: 2;
	}

	.icon .bar {
		fill: var(--color-text);
		stroke: none;
	}

	.chip-text {
		fill: var(--color-text);
		stroke: none;
		font-family: var(--font-mono);
		font-size: 13px;
		font-weight: 700;
	}

	.node-label {
		font-family: var(--font-display);
		font-size: var(--text-sm);
		color: var(--color-text);
		max-width: 7rem;
	}

	.arrow {
		flex: 1;
		min-width: 7rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-1);
	}

	.arrow-name {
		font-size: var(--text-xs);
		color: var(--color-text-muted);
		text-align: center;
	}

	.line {
		width: 100%;
		height: 14px;
	}

	.line .shaft {
		stroke: var(--color-text-muted);
		stroke-width: 2;
	}

	.line .head {
		fill: var(--color-text-muted);
	}

	/* ---- Lightning stickers ---- */
	.sticker {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		font-weight: 700;
		font-size: var(--text-sm);
	}

	.bolt {
		width: 10px;
		height: 14px;
		fill: currentColor;
	}

	.sticker-coherence {
		color: var(--color-positive);
	}

	.sticker-validity {
		color: var(--color-model);
	}

	.sticker-faithfulness {
		color: var(--color-link);
	}

	.loop {
		width: 16px;
		height: 16px;
	}

	.loop path {
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
	}

	.loop polygon {
		fill: currentColor;
	}

	/* ---- Mobile: stack the boxes, wrap the flow ---- */
	@media (max-width: 950px) {
		.flow {
			grid-template-columns: 1fr;
		}

		.callout-seen {
			grid-column: 1;
			grid-row: 1;
			margin-bottom: 0;
		}

		.track {
			grid-column: 1;
			grid-row: 2;
			flex-wrap: wrap;
			justify-content: center;
		}

		.callout-truth {
			grid-column: 1;
			grid-row: 3;
		}

		.callout-behavior {
			grid-column: 1;
			grid-row: 4;
		}

		.arrow {
			min-width: 5rem;
		}
	}
</style>
