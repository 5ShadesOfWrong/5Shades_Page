---
/**
 * ArchetypeViewer.astro — §3 The 5(0) Shades of Wrong (v3, user review 2026-10-21)
 * ---------------------------------------------------------------------------------
 * One archetype at a time (presentation-friendly), with prev/next controls,
 * dot indicators, and paper-style scene graphics: TWO panels per archetype —
 *
 *   [Prediction panel]            [Explanation panel]
 *    model-used features           explanation-highlighted features
 *    shown in PURPLE               shown in GREEN (honest) / RED (misleading)
 *
 * matching the tutorial figure (Prediction / Explanation side by side).
 * The wolf is a single-path howling silhouette; the moons have craters.
 *
 * All six archetypes are server-rendered; the viewer toggles visibility with
 * the `hidden` attribute → works without JS (stacked list), and archetype.ts
 * adds the one-at-a-time behavior + keyboard arrows.
 *
 * Security: typed JSON data, auto-escaped; no dynamic HTML.
 */
import archetypes from '../data/archetypes.json';
import type { Archetype, ArchetypesData } from '../schemas/schemas';

const data = archetypes as unknown as ArchetypesData;
const list = data.archetypes;
const legend = data.legend;

/**
 * Stylized howling-wolf silhouette — user-provided icon (public/icons/wolf_icon3.avif),
 * converted once to wolf-mask.png (transparent background). Rendered as a CSS-masked
 * layer so the silhouette can be tinted per panel (purple/green/red) with a class.
 */
const WOLF_MASK = 'icons/wolf-mask.png';

// Ground strip shared by both panels.
const GROUND_PATH = 'M0 152 Q 60 138 120 150 T 240 146 L 240 200 L 0 200 Z';

// Scene semantics per archetype (user review 2026-10-21 — paper-style panels):
//   Prediction panel  → features the model ACTUALLY used, in purple.
//   Explanation panel → features the explanation highlights: GREEN when the
//                       highlight is honest (same feature the model used),
//                       RED when it is misleading.
//   Everything not used/highlighted in a panel is dimmed (unimportant).
const sceneFor = (a: Archetype) => {
	const usedIsShape = a.modelUsed.startsWith('shape');
	const usedIsMoons = a.modelUsed.includes('moon');
	const usedIsBackground = a.modelUsed.includes('background');
	const highlightIsShape = a.highlighted.startsWith('shape');
	const highlightIsMoons = a.highlighted.includes('moon');
	const highlightIsBackground = a.highlighted.includes('background');
	// Honest highlight = the explanation points at the same feature the model used.
	const honest =
		(highlightIsShape && usedIsShape) ||
		((highlightIsMoons || highlightIsBackground) && (usedIsMoons || usedIsBackground));
	// The prediction word turns red when it disagrees with the explanation's claim.
	const predictionMatches = a.explanation.toLowerCase().includes(a.prediction.toLowerCase());
	return {
		usedIsShape,
		usedIsMoons,
		usedIsBackground,
		highlightIsShape,
		highlightIsMoons,
		highlightIsBackground,
		honest,
		predictionMatches,
		animal: a.prediction.toLowerCase(),
	};
};
---

<section id="archetypes" class="section" aria-labelledby="archetypes-title">
	<div class="container">
		<h2 id="archetypes-title" data-reveal>The 5(0) Shades of Wrong</h2>
		<p class="intro" data-reveal data-reveal-delay="1">
			Combining the three lenses yields six archetypes: the Perfect Explainer —
			and the five Shades of Wrong. Step through them one at a time.
		</p>

		<ul class="legend" aria-label="Color legend from the paper" data-reveal data-reveal-delay="2">
			{
				Object.values(legend).map((item) => (
					<li>
						<span class="swatch" style={`background: ${item.color}`} aria-hidden="true" />
						{item.label}
					</li>
				))
			}
		</ul>

		<div class="viewer" data-reveal data-reveal-delay="2">
			<div class="stage" data-viewer-stage>
				{
					list.map((a) => {
						const scene = sceneFor(a);
						return (
							<article
								class:list={['archetype', { correct: a.verdict === 'correct' }]}
								id={`archetype-${a.id}`}
								data-archetype
								hidden={a.letter !== 'a'}
								aria-hidden={a.letter !== 'a' ? 'true' : undefined}
							>
								<header class="head">
									<h3>{a.name}</h3>
									<span class:list={['verdict', a.verdict]}>
										{a.verdict === 'correct' ? 'correct' : 'wrong'}
									</span>
								</header>

								<div class="body">
									{/* ---- Two paper-style panels: Prediction / Explanation ---- */}
									{[
										{ kind: 'prediction' as const },
										{ kind: 'explanation' as const },
									].map((panel) => {
										const isPred = panel.kind === 'prediction';
										const skyCls = isPred
											? { 'sky-used': scene.usedIsBackground }
											: {
													'sky-hl-good': scene.highlightIsBackground && scene.honest,
													'sky-hl-bad': scene.highlightIsBackground && !scene.honest,
												};
										const moonCls = isPred
											? {
													'feat-used': scene.usedIsMoons || scene.usedIsBackground,
													'feat-dim': !(scene.usedIsMoons || scene.usedIsBackground),
												}
											: {
													'feat-hl-good':
														(scene.highlightIsMoons || scene.highlightIsBackground) && scene.honest,
													'feat-hl-bad':
														(scene.highlightIsMoons || scene.highlightIsBackground) && !scene.honest,
													'feat-dim': !(scene.highlightIsMoons || scene.highlightIsBackground),
												};
										const wolfCls = isPred
											? { 'feat-used': scene.usedIsShape, 'feat-dim': !scene.usedIsShape }
											: {
													'feat-hl-good': scene.highlightIsShape && scene.honest,
													'feat-hl-bad': scene.highlightIsShape && !scene.honest,
													'feat-dim': !scene.highlightIsShape,
												};
										return (
											<figure class="scene-figure">
												<div class="scene">
													<svg
														viewBox="0 0 240 200"
														role="img"
														aria-label={
															isPred
																? `Prediction scene: the model actually used the ${a.modelUsed} (purple).`
																: `Explanation scene: the explanation highlights the ${a.highlighted} (${scene.honest ? 'green — honest' : 'red — misleading'}).`
														}
													>
														<rect x="0" y="0" width="240" height="200" rx="12" class:list={['sky', skyCls]} />
														<g class:list={['moon', moonCls]}>
															<circle cx="34" cy="30" r="14" class="moon-disc" />
															<circle cx="29" cy="25" r="3.5" class="crater" />
															<circle cx="39" cy="34" r="2.5" class="crater" />
															<circle cx="36" cy="24" r="2" class="crater" />
														</g>
														<g class:list={['moon', moonCls]}>
															<circle cx="206" cy="30" r="14" class="moon-disc" />
															<circle cx="201" cy="25" r="3.5" class="crater" />
															<circle cx="211" cy="34" r="2.5" class="crater" />
															<circle cx="208" cy="24" r="2" class="crater" />
														</g>
														<path d={GROUND_PATH} class="ground" />
													</svg>
													{/* Wolf layer — HTML sibling of the SVG (a <span> inside <svg>
													    is invalid and breaks out of the panel). */}
													<span
														class:list={['wolf', wolfCls]}
														style={`-webkit-mask-image: url(${import.meta.env.BASE_URL.replace(/\/$/, '')}/${WOLF_MASK}); mask-image: url(${import.meta.env.BASE_URL.replace(/\/$/, '')}/${WOLF_MASK});`}
														aria-hidden="true"
													/>
												</div>
												<figcaption class="scene-caption">
													{isPred ? (
														<>
															Prediction:{' '}
															<strong class:list={[scene.predictionMatches ? 'ok' : 'bad']}>
																{a.prediction}
															</strong>
														</>
													) : (
														'Explanation'
													)}
												</figcaption>
											</figure>
										);
									})}

									<div class="story">
										<p class="prediction">
											Prediction: <strong>{a.prediction}</strong>
										</p>
										<p class="explanation">&ldquo;{a.explanation}&rdquo;</p>

										<dl class="facts">
											<div>
												<dt>Model actually used</dt>
												<dd class="used">{a.modelUsed}</dd>
											</div>
											<div>
												<dt>Explanation highlighted</dt>
												<dd class:list={['highlighted', { bad: !scene.honest }]}>{a.highlighted}</dd>
											</div>
										</dl>

										<p class="summary">{a.summary}</p>

										<ul class="chips" aria-label={`${a.name} verdicts`}>
											<li class:list={[a.coherent ? 'yes' : 'no']}>Coherent</li>
											<li class:list={[a.valid ? 'yes' : 'no']}>Valid</li>
											<li class:list={[a.faithful ? 'yes' : 'no']}>Faithful</li>
										</ul>
									</div>
								</div>
							</article>
						);
					})
				}
			</div>

			<!-- Viewer controls -->
			<div class="controls">
				<button type="button" class="nav-btn" data-viewer-prev aria-label="Previous archetype">
					←
				</button>
				<div class="dots" data-viewer-dots role="tablist" aria-label="Archetype selector">
					{
						list.map((a, i) => (
							<button
								type="button"
								class:list={['dot-btn', { active: i === 0 }]}
								data-viewer-dot={a.id}
								aria-label={`Show archetype ${a.name}`}
								aria-current={i === 0 ? 'true' : undefined}
							/>
						))
					}
				</div>
				<button type="button" class="nav-btn" data-viewer-next aria-label="Next archetype">
					→
				</button>
				<span class="counter" data-viewer-counter aria-live="polite">1 / 6</span>
			</div>
		</div>
	</div>
</section>

<style>
	.intro {
		margin-top: var(--space-4);
		font-size: var(--text-lg);
		color: var(--color-text-muted);
		max-width: 52ch;
	}

	/* ---- Paper legend ---- */
	.legend {
		margin-top: var(--space-6);
		padding: 0;
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}

	.legend li {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
	}

	.swatch {
		width: 12px;
		height: 12px;
		border-radius: 3px;
		display: inline-block;
	}

	/* ---- Viewer shell ---- */
	.viewer {
		margin-top: var(--space-8);
		max-width: 62rem;
	}

	.stage {
		position: relative;
	}

	/* ---- Archetype card ---- */
	.archetype {
		background: var(--color-bg-raised);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--space-8);
		box-shadow: var(--shadow-card);
	}

	.archetype.correct {
		border-color: color-mix(in srgb, var(--color-positive) 55%, var(--color-border));
	}

	.head {
		display: flex;
		align-items: center;
		gap: var(--space-3);
	}

	.verdict {
		margin-left: auto;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		padding: 3px 12px;
		border-radius: 999px;
	}

	.verdict.correct {
		color: var(--color-positive);
		border: 1px solid var(--color-positive);
	}

	.verdict.wrong {
		color: var(--color-negative);
		border: 1px solid var(--color-negative);
	}

	/* ---- Body: prediction panel + explanation panel + story ---- */
	.body {
		margin-top: var(--space-6);
		display: grid;
		grid-template-columns: minmax(11rem, 14rem) minmax(11rem, 14rem) 1fr;
		gap: var(--space-6);
		align-items: start;
	}

	.scene {
		position: relative; /* anchors the absolutely-positioned wolf layer */
		aspect-ratio: 240 / 200;
		overflow: hidden;
		border-radius: var(--radius-md);
		border: 1px solid var(--color-border);
	}

	.scene svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.scene-figure {
		margin: 0;
	}

	.scene-caption {
		margin-top: var(--space-2);
		text-align: center;
		font-size: var(--text-xs);
		font-family: var(--font-mono);
		color: var(--color-text-faint);
	}

	.scene-caption .ok {
		color: var(--color-positive);
	}

	.scene-caption .bad {
		color: var(--color-negative);
	}

	/* ---- Scene parts ---- */
	.sky {
		fill: var(--color-bg-overlay);
		transition: fill var(--duration-normal) var(--ease-out);
	}

	/* Background used/highlighted → tint the whole sky (paper-style) */
	.sky-used {
		fill: color-mix(in srgb, var(--color-model) 30%, var(--color-bg-overlay));
	}

	.sky-hl-good {
		fill: color-mix(in srgb, var(--color-positive) 30%, var(--color-bg-overlay));
	}

	.sky-hl-bad {
		fill: color-mix(in srgb, var(--color-negative) 30%, var(--color-bg-overlay));
	}

	.moon .moon-disc {
		fill: var(--color-neutral);
		opacity: 0.45;
		transition: fill var(--duration-normal) var(--ease-out),
			opacity var(--duration-normal) var(--ease-out);
	}

	.moon .crater {
		fill: var(--color-bg-overlay);
		opacity: 0.6;
	}

	/* Feature states (paper legend): purple = used, green = honest highlight,
	   red = misleading highlight, dim = unimportant */
	.moon .feat-used {
		fill: var(--color-model);
		opacity: 1;
	}

	.moon .feat-hl-good {
		fill: var(--color-positive);
		opacity: 1;
	}

	.moon .feat-hl-bad {
		fill: var(--color-negative);
		opacity: 1;
	}

	.moon .feat-dim {
		opacity: 0.45;
	}

	.ground {
		fill: var(--color-neutral);
		opacity: 0.18;
	}

	.wolf {
		display: block;
		position: absolute;
		left: 50%;
		bottom: 4%;
		transform: translateX(-50%);
		width: 62%; /* fits inside the panel, above the ground strip */
		aspect-ratio: 1 / 1;
		background-color: var(--color-neutral);
		opacity: 0.55;
		mask-size: contain;
		mask-repeat: no-repeat;
		mask-position: center bottom;
		-webkit-mask-size: contain;
		-webkit-mask-repeat: no-repeat;
		-webkit-mask-position: center bottom;
		transition: background-color var(--duration-normal) var(--ease-out),
			opacity var(--duration-normal) var(--ease-out);
	}

	.wolf.feat-used {
		background-color: var(--color-model);
		opacity: 1;
	}

	.wolf.feat-hl-good {
		background-color: var(--color-positive);
		opacity: 1;
	}

	.wolf.feat-hl-bad {
		background-color: var(--color-negative);
		opacity: 1;
	}

	/* ---- Story column ---- */
	.prediction {
		font-size: var(--text-lg);
		color: var(--color-text-muted);
	}

	.prediction strong {
		color: var(--color-text);
	}

	.explanation {
		margin-top: var(--space-2);
		font-style: italic;
		font-size: var(--text-lg);
	}

	.facts {
		margin-top: var(--space-6);
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-4);
	}

	.facts dt {
		color: var(--color-text-faint);
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	.facts dd {
		margin: var(--space-1) 0 0;
		font-weight: 600;
	}

	.facts .used {
		color: var(--color-model);
	}

	.facts .highlighted {
		color: var(--color-positive);
	}

	.summary {
		margin-top: var(--space-6);
		color: var(--color-text-muted);
	}

	.chips {
		margin-top: var(--space-4);
		padding: 0;
		list-style: none;
		display: flex;
		gap: var(--space-2);
		flex-wrap: wrap;
	}

	.chips li {
		font-size: var(--text-xs);
		font-family: var(--font-mono);
		padding: 2px 10px;
		border-radius: 999px;
		border: 1px solid var(--color-border);
		color: var(--color-text-muted);
	}

	.chips li.yes {
		border-color: var(--color-positive);
		color: var(--color-positive);
	}

	.chips li.no {
		border-color: var(--color-negative);
		color: var(--color-negative);
	}

	/* ---- Controls ---- */
	.controls {
		margin-top: var(--space-6);
		display: flex;
		align-items: center;
		justify-content: center;
		gap: var(--space-6);
	}

	.nav-btn {
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 50%;
		border: 1px solid var(--color-border);
		background: var(--color-bg-raised);
		color: var(--color-text);
		font-size: var(--text-lg);
		cursor: pointer;
		transition: border-color var(--duration-fast) var(--ease-out),
			transform var(--duration-fast) var(--ease-out);
	}

	.nav-btn:hover {
		border-color: var(--color-model);
		transform: scale(1.08);
	}

	.dots {
		display: flex;
		gap: var(--space-3);
	}

	.dot-btn {
		width: 12px;
		height: 12px;
		padding: 0;
		border-radius: 50%;
		border: none;
		background: var(--color-border);
		cursor: pointer;
		transition: background var(--duration-fast) var(--ease-out),
			transform var(--duration-fast) var(--ease-out);
	}

	.dot-btn:hover {
		transform: scale(1.3);
	}

	.dot-btn.active {
		background: var(--color-model);
		transform: scale(1.3);
	}

	.counter {
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		color: var(--color-text-faint);
		min-width: 3.5rem;
	}

	/* ---- Mobile ---- */
	@media (max-width: 800px) {
		.body {
			grid-template-columns: 1fr;
		}

		.scene-figure {
			max-width: 16rem;
			margin-inline: auto;
		}

		.facts {
			grid-template-columns: 1fr;
		}
	}
</style>

<script src="../scripts/archetype.ts"></script>
