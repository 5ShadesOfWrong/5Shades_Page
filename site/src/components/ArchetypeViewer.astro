---
import './ArchetypeViewer.css';
import archetypes from '../data/archetypes.json';
import lenses from '../data/lenses.json';
import Term from './Term.astro';
import type { Archetype, ArchetypesData, LensesData } from '../schemas/schemas';

/**
 * ArchetypeViewer.astro — §3 The 5(0) Shades of Wrong (v3, user review 2026-10-21)
 * ---------------------------------------------------------------------------------
 * One archetype at a time (presentation-friendly), with prev/next controls,
 * dot indicators, and paper-style scene graphics: THREE panels per archetype —
 *
 *   [Ground Truth]  ──▶  [Explanation]  ◀──  [Prediction]
 *    untouched image     explanation-         model-used features
 *    (nothing painted)   highlighted          shown in PURPLE
 *                        GREEN honest /
 *                        RED misleading
 *
 * arranged exactly like the §2 scheme: arrows point toward the center
 * (Explanation), and the story texts sit BELOW the scheme (user review
 * 2026-10-28). The wolf is a single-path howling silhouette; the moons
 * have craters.
 *
 * All six archetypes are server-rendered; the viewer toggles visibility with
 * the `hidden` attribute → works without JS (stacked list), and archetype.ts
 * adds the one-at-a-time behavior + keyboard arrows.
 *
 * Security: typed JSON data, auto-escaped; no dynamic HTML.
 */

const data = archetypes as unknown as ArchetypesData;
// Perfect Explainer commented out per user review 2026-10-28: the site now
// teaches only the 5 Shades of Wrong. The data stays in archetypes.json
// (the validator still expects 6 entries) — it is simply filtered out here.
const list = data.archetypes.filter((a) => a.id !== 'perfect-explainer');
const legend = data.legend;

// Term → concise definition (from lenses.json tooltips) for the verdict chips.
// Each term has a positive variant (green) and a negated variant (red) so the
// tooltip always matches the verdict shown (user review 2026-10-26).
const lensList = (lenses as unknown as LensesData).lenses;
const termTips: Record<string, { ok: string; bad: string }> = {
	Coherent: {
		ok: lensList.find((l) => l.id === 'coherence')?.tooltip ?? '',
		bad: 'The explanation contradicts itself — its internal logic does not hold.',
	},
	Valid: {
		ok: lensList.find((l) => l.id === 'validity')?.tooltip ?? '',
		bad: 'The explanation does not match the real-world facts — it misrepresents what is actually true.',
	},
	Faithful: {
		ok: lensList.find((l) => l.id === 'faithfulness')?.tooltip ?? '',
		bad: 'The explanation does not reflect how the model actually processed the input.',
	},
};

/**
 * Stylized howling-wolf silhouette — user-provided icon (public/icons/wolf_icon3.avif),
 * converted once to wolf-mask.png (transparent background). Rendered as a CSS-masked
 * layer so the silhouette can be tinted per panel (purple/green/red) with a class.
 */
const WOLF_MASK = 'icons/wolf-mask.png';

/**
 * Panel feature states from the explicit scene data (archetypes.json):
 *   Prediction panel  → `used` flags (purple = what the model actually used)
 *   Explanation panel → `highlight` flags (green when honest, red when misleading)
 * A highlight is HONEST when it points at the same feature the model used.
 */
function panelState(
	scene: NonNullable<Archetype['scene']>,
	kind: 'prediction' | 'explanation'
) {
	const flags = kind === 'prediction' ? scene.used : scene.highlight;
	// `highlightBad` override (Illuminator): the explanation highlights the
	// very feature the model used — but that feature is the WRONG reason —
	// so its highlight renders red (misleading) instead of green.
	const honest =
		scene.highlightBad !== true &&
		flags.wolf === scene.used.wolf &&
		flags.sky === scene.used.sky &&
		flags.leftMoon === scene.used.leftMoon &&
		flags.rightMoon === scene.used.rightMoon;

	const moonCls =
		kind === 'prediction'
			? { 'feat-used': flags.leftMoon || flags.rightMoon, 'feat-dim': !(flags.leftMoon || flags.rightMoon) }
			: {
					'feat-hl-good': (flags.leftMoon || flags.rightMoon) && honest,
					'feat-hl-bad': (flags.leftMoon || flags.rightMoon) && !honest,
					'feat-dim': !(flags.leftMoon || flags.rightMoon),
				};

	return {
		skyCls:
			kind === 'prediction'
				? { 'feat-used': flags.sky, 'feat-dim': !flags.sky }
				: {
						'feat-hl-good': flags.sky && honest,
						'feat-hl-bad': flags.sky && !honest,
						'feat-dim': !flags.sky,
					},
		moonCls,
		wolfCls:
			kind === 'prediction'
				? { 'feat-used': flags.wolf, 'feat-dim': !flags.wolf }
				: {
						'feat-hl-good': flags.wolf && honest,
						'feat-hl-bad': flags.wolf && !honest,
						'feat-dim': !flags.wolf,
					},
	};
}

// Ground strip shared by all three panels.
const GROUND_PATH = 'M0 152 Q 60 138 120 150 T 240 146 L 240 200 L 0 200 Z';

// Scene semantics per archetype (user review 2026-10-21 — paper-style panels):
//   Prediction panel  → features the model ACTUALLY used, in purple.
//   Explanation panel → features the explanation highlights: GREEN when the
//                       highlight is honest (same feature the model used),
//                       RED when it is misleading.
//   Everything not used/highlighted in a panel is dimmed (unimportant).
//   (The old string-parsing sceneFor was replaced by explicit per-archetype
//    scene data in archetypes.json + panelState() above — user spec 2026-10-21.)

---

<section id="archetypes" class="section" aria-labelledby="archetypes-title">
	<div class="container">
		<h2 id="archetypes-title" data-reveal>The 5(0) Shades of Wrong</h2>
		<p class="intro" data-reveal data-reveal-delay="1">
		Combining the three lenses yields the five Shades of Wrong — five ways
		an explanation can be wrong. Step through them one at a time.
		</p>

		<ul class="legend" aria-label="Color legend from the paper" data-reveal data-reveal-delay="2">
			{
				Object.values(legend).map((item) => (
					<li>
						<span class="swatch" style={`background: ${item.color}`} aria-hidden="true" />
						{item.label}
					</li>
				))
			}
		</ul>

		<div class="viewer" data-reveal data-reveal-delay="2">
			<div class="stage" data-viewer-stage>
				{
					list.map((a, i) => {
						if (!a.scene) return null; // schema guarantees scene data
						// Explanation-panel honesty, computed once per archetype —
						// used by the story column (outside the panel loop below).
						const explanationHonest = panelState(a.scene, 'explanation').honest;
						return (
							<article
								class:list={['archetype', { correct: a.verdict === 'correct' }]}
								id={`archetype-${a.id}`}
								data-archetype
								hidden={i !== 0}
								aria-hidden={i !== 0 ? 'true' : undefined}
							>
								<header class="head">
									<h3>{a.name}</h3>
									<span class:list={['verdict', a.verdict]}>
										{a.verdict === 'correct' ? 'correct' : 'wrong'}
									</span>
								</header>

								<div class="body">
										{/* ---- Three paper-style panels, mirroring the Explanation
										     Wrongness scheme: Ground Truth (what is true) →
										     Prediction (what the model used) → Explanation
										     (what the explainee sees) ---- */}
										{[
											{ kind: 'groundtruth' as const },
											{ kind: 'explanation' as const },
											{ kind: 'prediction' as const },
										].map((panel, i) => {
											const isTruth = panel.kind === 'groundtruth';
											const isPred = panel.kind === 'prediction';
											// Ground-truth panel: the untouched image — the exact same
											// scene with NOTHING painted (no feature coloring).
											const state = isTruth
												? { skyCls: {}, moonCls: {}, wolfCls: {} }
												: panelState(a.scene, panel.kind);
										// Moon count per PANEL (user review 2026-10-28): the ground
										// truth always shows the original image — wolf + ONE full
										// moon — while prediction/explanation follow the scene data
										// (Cassandra + Hallucinator: 2 moons).
										const moonCount = isTruth ? 1 : a.scene.moons;
										// Two-moon scenes: LEFT moon is a waxing crescent, nudged
										// right of the scheme badge sitting in the top-left corner
										// (at cx 34 it hid behind the badge); RIGHT moon is full.
										// Single-moon scenes: one full moon, centered.
										const moonPositions =
											moonCount === 2
												? [
														{ cx: 70, cy: 30, r: 14, key: 'leftMoon', crescent: true },
														{ cx: 206, cy: 30, r: 14, key: 'rightMoon', crescent: false },
													]
												: [{ cx: 120, cy: 30, r: 14, key: 'leftMoon', crescent: false }];
										const figure = (
											<figure class="scene-figure">
												{/* Verdict slot above the scene: only the Explanation panel
												    carries the Coherence chip (paper scheme — the sticker
												    floats above the chart). Empty slots on the other panels
												    keep all three scenes vertically aligned. */}
												<div class="chip-slot">
													{panel.kind === 'explanation' && (
														<span class:list={['chip', a.coherent ? 'chip--positive' : 'chip--negative']}>
															<Term
																term="Coherent"
																definition={a.coherent ? termTips.Coherent.ok : termTips.Coherent.bad}
																variant={a.coherent ? 'yes' : 'no'}
															/>
														</span>
													)}
												</div>
												<div
													class:list={[
														'scene',
														// Border color = the panel's scheme color from §2:
														// purple (Ground Truth), green (Explanation), blue (Prediction).
														panel.kind === 'groundtruth'
															? 'scene-truth'
															: panel.kind === 'explanation'
																? 'scene-explanation'
																: 'scene-prediction',
													]}
												>
													<svg
														viewBox="0 0 240 200"
														role="img"
														aria-label={
																isTruth
																	? 'Ground truth scene: the untouched image — it truly shows a wolf, recognizable by its shape.'
																	: isPred
																		? `Prediction scene: the model actually used the ${a.modelUsed} (purple).`
																		: `Explanation scene: the explanation highlights the ${a.highlighted} (${state.honest ? 'green — honest' : 'red — misleading'}).`
														}
													>
														<rect x="0" y="0" width="240" height="200" rx="12" class:list={['sky', state.skyCls]} />
														{moonPositions.map((m) => {
															// Each moon is colored independently: the flags
															// leftMoon/rightMoon decide per position.
															const active = isTruth
																? false
																: isPred
																	? a.scene.used[m.key]
																	: a.scene.highlight[m.key];
															const cls = isTruth
																? {}
																: isPred
																	? { 'feat-used': active, 'feat-dim': !active }
																	: {
																			'feat-hl-good': active && state.honest,
																			'feat-hl-bad': active && !state.honest,
																			'feat-dim': !active,
																		};
															// Waxing crescent: full disc minus an offset circle
															// (mask-style cutout), drawn with the disc's fill.
															if (m.crescent) {
																return (
																	<g class:list={['moon', 'moon-crescent', cls]}>
																		<path
																			d={`M ${m.cx} ${m.cy - m.r} a ${m.r} ${m.r} 0 1 0 0 ${2 * m.r} a ${m.r * 0.72} ${m.r} 0 1 1 0 ${-2 * m.r} Z`}
																			class="moon-disc"
																		/>
																		<circle cx={m.cx - 4} cy={m.cy - 4} r="2.5" class="crater" />
																		<circle cx={m.cx - 6} cy={m.cy + 3} r="2" class="crater" />
																	</g>
																);
															}
															return (
																<g class:list={['moon', cls]}>
																	<circle cx={m.cx} cy={m.cy} r={m.r} class="moon-disc" />
																	<circle cx={m.cx - 5} cy={m.cy - 5} r="3.5" class="crater" />
																	<circle cx={m.cx + 5} cy={m.cy + 4} r="2.5" class="crater" />
																	<circle cx={m.cx + 2} cy={m.cy - 6} r="2" class="crater" />
																</g>
															);
														})}
														<path d={GROUND_PATH} class="ground" />
													</svg>
													{/* Wolf layer — HTML sibling of the SVG (a <span> inside <svg>
													    is invalid and breaks out of the panel). */}
													<span
														class:list={['wolf', state.wolfCls]}
														style={`-webkit-mask-image: url(${import.meta.env.BASE_URL.replace(/\/$/, '')}/${WOLF_MASK}); mask-image: url(${import.meta.env.BASE_URL.replace(/\/$/, '')}/${WOLF_MASK});`}
														aria-hidden="true"
													/>
													{/* Scheme icon badge (user review 2026-10-28): the same
													    node icon as the §2 scheme, overlaid on each scene —
													    globe (Ground Truth), bar chart (Explanation),
													    AI chip (Prediction) — tinted with the panel color. */}
													<span class="scene-badge" aria-hidden="true">
														{panel.kind === 'groundtruth' && (
															<svg viewBox="0 0 48 48">
																<circle cx="24" cy="24" r="18" />
																<ellipse cx="24" cy="24" rx="8" ry="18" />
																<line x1="6" y1="24" x2="42" y2="24" />
															</svg>
														)}
														{panel.kind === 'explanation' && (
															<svg viewBox="0 0 48 48">
																<rect x="6" y="10" width="7" height="30" class="bar" />
																<rect x="17" y="18" width="7" height="22" class="bar" />
																<rect x="28" y="26" width="7" height="14" class="bar" />
																<rect x="39" y="32" width="7" height="8" class="bar" />
															</svg>
														)}
														{panel.kind === 'prediction' && (
															<svg viewBox="0 0 48 48">
																<rect x="12" y="12" width="24" height="24" rx="4" />
																<text x="24" y="29" text-anchor="middle" class="chip-text">AI</text>
																<line x1="17" y1="5" x2="17" y2="12" /><line x1="24" y1="5" x2="24" y2="12" /><line x1="31" y1="5" x2="31" y2="12" />
																<line x1="17" y1="36" x2="17" y2="43" /><line x1="24" y1="36" x2="24" y2="43" /><line x1="31" y1="36" x2="31" y2="43" />
																<line x1="5" y1="17" x2="12" y2="17" /><line x1="5" y1="24" x2="12" y2="24" /><line x1="5" y1="31" x2="12" y2="31" />
																<line x1="36" y1="17" x2="36" y2="24" /><line x1="36" y1="24" x2="43" y2="24" /><line x1="36" y1="31" x2="43" y2="31" />
															</svg>
														)}
													</span>
											</div>
											<figcaption class="scene-caption">
												{isTruth ? (
													<>
														Ground truth: <strong class="ok">it is a wolf</strong> —
														given the shape presented in the image
													</>
												) : isPred ? (
													<>
														Prediction:{' '}
														<strong class:list={[state.honest ? 'ok' : 'bad']}>
															{a.prediction}
														</strong>
													</>
												) : (
													'Explanation'
												)}
											</figcaption>
										</figure>
									);

									// Arrows between the panels, pointing toward the center
									// (Explanation) — same geometry as the §2 scheme arrows.
									// Each arrow carries its lens verdict below, exactly where
									// the paper puts its stickers: Validity on the Ground-Truth
									// arrow, Faithfulness on the Prediction arrow.
									if (i === 2) return [figure];
									const arrowGeom =
										i === 0
											? { shaft: 'M2 7 H106', head: '106,1.5 120,7 106,12.5' }
											: { shaft: 'M14 7 H118', head: '14,1.5 0,7 14,12.5' };
									const verdict =
										i === 0 ? (
											<span class:list={['chip', a.valid ? 'chip--positive' : 'chip--negative']}>
												<Term
													term="Valid"
													definition={a.valid ? termTips.Valid.ok : termTips.Valid.bad}
													variant={a.valid ? 'yes' : 'no'}
												/>
											</span>
										) : (
											<span class:list={['chip', a.faithful ? 'chip--positive' : 'chip--negative']}>
												<Term
													term="Faithful"
													definition={a.faithful ? termTips.Faithful.ok : termTips.Faithful.bad}
													variant={a.faithful ? 'yes' : 'no'}
												/>
											</span>
										);
									return [
										figure,
										<div class="flow-arrow">
											<svg class="line" viewBox="0 0 120 14" preserveAspectRatio="none" aria-hidden="true">
												<path d={arrowGeom.shaft} class="shaft" vector-effect="non-scaling-stroke" />
												<polygon points={arrowGeom.head} class="head" />
											</svg>
											{verdict}
										</div>,
									];
									})}

									<div class="story">
										<p class="explanation">&ldquo;{a.explanation}&rdquo;</p>

										<dl class="facts">
											<div>
												<dt>Model actually used</dt>
												<dd class="used">{a.modelUsed}</dd>
											</div>
											<div>
												<dt>Explanation highlighted</dt>
												<dd class:list={['highlighted', { bad: !explanationHonest }]}>{a.highlighted}</dd>
											</div>
										</dl>

										<p class="summary">{a.summary}</p>
									</div>
								</div>
							</article>
						);
					})
				}
			</div>

			<!-- Viewer controls -->
			<div class="controls">
				<button type="button" class="nav-btn" data-viewer-prev aria-label="Previous archetype">
					←
				</button>
				<div class="dots" data-viewer-dots role="tablist" aria-label="Archetype selector">
					{
						list.map((a, i) => (
							<button
								type="button"
								class:list={['dot-btn', { active: i === 0 }]}
								data-viewer-dot={a.id}
								aria-label={`Show archetype ${a.name}`}
								aria-current={i === 0 ? 'true' : undefined}
							/>
						))
					}
				</div>
				<button type="button" class="nav-btn" data-viewer-next aria-label="Next archetype">
					→
				</button>
				<span class="counter" data-viewer-counter aria-live="polite">1 / 6</span>
			</div>
		</div>
	</div>
</section>


<script src="../scripts/archetype.ts"></script>

