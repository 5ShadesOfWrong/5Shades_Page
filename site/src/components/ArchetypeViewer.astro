---
/**
 * ArchetypeViewer.astro — §3 The 5(0) Shades of Wrong (user review 2026-10-19)
 * -----------------------------------------------------------------------------
 * One archetype at a time (presentation-friendly), with prev/next controls,
 * dot indicators, and a real scene graphic per archetype (wolf/husky + moon
 * background, drawn as inline SVG — no external images needed).
 *
 * All six archetypes are server-rendered; the viewer toggles visibility with
 * the `hidden` attribute → works without JS (stacked list), and archetype.ts
 * adds the one-at-a-time behavior + keyboard arrows.
 *
 * Security: typed JSON data, auto-escaped; no dynamic HTML.
 */
import archetypes from '../data/archetypes.json';
import type { Archetype, ArchetypesData } from '../schemas/schemas';

const data = archetypes as unknown as ArchetypesData;
const list = data.archetypes;
const legend = data.legend;

// Scene graphic parameters per archetype: what the model used vs. what the
// explanation highlights — drawn as colored overlays on the same base scene.
// Colors come from the paper legend (purple = used, green/red = highlighted).
//
// Scene rules (user review 2026-10-21):
//   - The scene always shows TWO moons (the paper's spurious background
//     feature is "the 2 moons"); archetypes that highlight the background
//     get both moons tinted, plus a sky tint so the background highlight
//     is visible even though the moons are small.
//   - A "base image" panel (the untouched original) is rendered next to the
//     annotated scene so viewers can compare.
const sceneFor = (a: Archetype) => ({
	// The "true reason" the model used (purple when it's the shape, moons when background)
	usedIsShape: a.modelUsed.startsWith('shape'),
	usedIsMoons: a.modelUsed.includes('moon'),
	// What the explanation claims (highlighted element)
	highlightIsShape: a.highlighted.startsWith('shape'),
	highlightIsMoons: a.highlighted.includes('moon'),
	highlightIsBackground: a.highlighted.includes('background'),
	animal: a.prediction.toLowerCase(), // wolf or husky silhouette
});
---

<section id="archetypes" class="section" aria-labelledby="archetypes-title">
	<div class="container">
		<h2 id="archetypes-title" data-reveal>The 5(0) Shades of Wrong</h2>
		<p class="intro" data-reveal data-reveal-delay="1">
			Combining the three lenses yields six archetypes: the perfect explainer
			(a) — and the five shades of wrong (b–f). Step through them one at a time.
		</p>

		<ul class="legend" aria-label="Color legend from the paper" data-reveal data-reveal-delay="2">
			{
				Object.values(legend).map((item) => (
					<li>
						<span class="swatch" style={`background: ${item.color}`} aria-hidden="true" />
						{item.label}
					</li>
				))
			}
		</ul>

		<div class="viewer" data-reveal data-reveal-delay="2">
			<div class="stage" data-viewer-stage>
				{
					list.map((a, i) => {
						const scene = sceneFor(a);
						return (
							<article
								class:list={['archetype', { correct: a.verdict === 'correct' }]}
								id={`archetype-${a.id}`}
								data-archetype
								hidden={i !== 0}
								aria-hidden={i !== 0 ? 'true' : undefined}
							>
								<header class="head">
									<span class="letter" aria-hidden="true">({a.letter})</span>
									<h3>{a.name}</h3>
									<span class:list={['verdict', a.verdict]}>
										{a.verdict === 'correct' ? 'correct' : 'wrong'}
									</span>
								</header>

								<div class="body">
									{/* ---- Base image (the untouched original) ---- */}
									<figure class="scene-figure">
										<svg
											class="scene scene-base"
											viewBox="0 0 320 200"
											role="img"
											aria-label={`Base image: a ${scene.animal} in a landscape with two moons in the sky. No annotations.`}
										>
											<rect x="0" y="0" width="320" height="200" rx="12" class="sky" />
											<circle cx="52" cy="48" r="20" class="moon" />
											<circle cx="268" cy="48" r="20" class="moon" />
											<path d="M0 150 Q 80 130 160 148 T 320 142 L 320 200 L 0 200 Z" class="ground" />
											<g class="animal">
												<ellipse cx="140" cy="140" rx="52" ry="26" />
												<circle cx="196" cy="118" r="17" />
												<polygon points="186,104 190,88 196,103" />
												<polygon points="200,102 206,87 210,103" />
												<polygon points="210,120 228,124 210,128" />
												<path d="M 90 136 Q 66 128 62 108 Q 78 116 92 122 Z" />
												<rect x="106" y="158" width="9" height="26" rx="4" />
												<rect x="126" y="160" width="9" height="24" rx="4" />
												<rect x="152" y="160" width="9" height="24" rx="4" />
												<rect x="170" y="158" width="9" height="26" rx="4" />
											</g>
										</svg>
										<figcaption class="scene-caption">Original image</figcaption>
									</figure>

									{/* ---- Annotated scene (model-used vs. explanation-highlighted) ---- */}
									<figure class="scene-figure">
										<svg
											class="scene"
											viewBox="0 0 320 200"
											role="img"
											aria-label={`Annotated scene: the model used the ${a.modelUsed}; the explanation highlights the ${a.highlighted}.`}
										>
										{/* sky — tinted when the explanation highlights the background */}
										<rect
											x="0" y="0" width="320" height="200" rx="12"
											class:list={['sky', { 'sky-highlighted': scene.highlightIsBackground }]}
										/>
										{/* TWO moons — the spurious background feature. Tinted when the
										    moons/background are what the model used or what is highlighted. */}
										<circle
											cx="52" cy="48" r="20"
											class:list={['moon', {
												'moon-used': scene.usedIsMoons || !scene.usedIsShape,
												'moon-highlighted': scene.highlightIsMoons || scene.highlightIsBackground,
											}]}
										/>
										<circle
											cx="268" cy="48" r="20"
											class:list={['moon', {
												'moon-used': scene.usedIsMoons || !scene.usedIsShape,
												'moon-highlighted': scene.highlightIsMoons || scene.highlightIsBackground,
											}]}
										/>
										{/* ground */}
										<path d="M0 150 Q 80 130 160 148 T 320 142 L 320 200 L 0 200 Z" class="ground" />
										{/* animal silhouette — the shape feature */}
										<g class:list={['animal', { 'animal-used': scene.usedIsShape, 'animal-highlighted': scene.highlightIsShape }]}>
											<ellipse cx="140" cy="140" rx="52" ry="26" />
											<circle cx="196" cy="118" r="17" />
											<polygon points="186,104 190,88 196,103" />
											<polygon points="200,102 206,87 210,103" />
											<polygon points="210,120 228,124 210,128" />
											<path d="M 90 136 Q 66 128 62 108 Q 78 116 92 122 Z" />
											<rect x="106" y="158" width="9" height="26" rx="4" />
											<rect x="126" y="160" width="9" height="24" rx="4" />
											<rect x="152" y="160" width="9" height="24" rx="4" />
											<rect x="170" y="158" width="9" height="26" rx="4" />
										</g>
									</svg>
											<figcaption class="scene-caption">Annotated image</figcaption>
										</figure>

									<div class="story">
										<p class="prediction">
											Prediction: <strong>{a.prediction}</strong>
										</p>
										<p class="explanation">&ldquo;{a.explanation}&rdquo;</p>

										<dl class="facts">
											<div>
												<dt>Model actually used</dt>
												<dd class="used">{a.modelUsed}</dd>
											</div>
											<div>
												<dt>Explanation highlighted</dt>
												<dd class="highlighted">{a.highlighted}</dd>
											</div>
										</dl>

										<p class="summary">{a.summary}</p>

										<ul class="chips" aria-label={`${a.name} verdicts`}>
											<li class:list={[a.coherent ? 'yes' : 'no']}>Coherent</li>
											<li class:list={[a.valid ? 'yes' : 'no']}>Valid</li>
											<li class:list={[a.faithful ? 'yes' : 'no']}>Faithful</li>
										</ul>
									</div>
								</div>
							</article>
						);
					})
				}
			</div>

			<!-- Viewer controls -->
			<div class="controls">
				<button type="button" class="nav-btn" data-viewer-prev aria-label="Previous archetype">
					←
				</button>
				<div class="dots" data-viewer-dots role="tablist" aria-label="Archetype selector">
					{
						list.map((a, i) => (
							<button
								type="button"
								class:list={['dot-btn', { active: i === 0 }]}
								data-viewer-dot={a.id}
								aria-label={`Show archetype (${a.letter}) ${a.name}`}
								aria-current={i === 0 ? 'true' : undefined}
							/>
						))
					}
				</div>
				<button type="button" class="nav-btn" data-viewer-next aria-label="Next archetype">
					→
				</button>
				<span class="counter" data-viewer-counter aria-live="polite">1 / 6</span>
			</div>
		</div>
	</div>
</section>

<style>
	.intro {
		margin-top: var(--space-4);
		font-size: var(--text-lg);
		color: var(--color-text-muted);
		max-width: 52ch;
	}

	/* ---- Paper legend ---- */
	.legend {
		margin-top: var(--space-6);
		padding: 0;
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}

	.legend li {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
	}

	.swatch {
		width: 12px;
		height: 12px;
		border-radius: 3px;
		display: inline-block;
	}

	/* ---- Viewer shell ---- */
	.viewer {
		margin-top: var(--space-8);
		max-width: 62rem;
	}

	.stage {
		position: relative;
	}

	/* ---- Archetype card ---- */
	.archetype {
		background: var(--color-bg-raised);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--space-8);
		box-shadow: var(--shadow-card);
	}

	.archetype.correct {
		border-color: color-mix(in srgb, var(--color-positive) 55%, var(--color-border));
	}

	.head {
		display: flex;
		align-items: center;
		gap: var(--space-3);
	}

	.letter {
		font-family: var(--font-mono);
		color: var(--color-model);
		font-size: var(--text-lg);
	}

	.verdict {
		margin-left: auto;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		padding: 3px 12px;
		border-radius: 999px;
	}

	.verdict.correct {
		color: var(--color-positive);
		border: 1px solid var(--color-positive);
	}

	.verdict.wrong {
		color: var(--color-negative);
		border: 1px solid var(--color-negative);
	}

	/* ---- Body: base image + annotated scene + story ---- */
	.body {
		margin-top: var(--space-6);
		display: grid;
		grid-template-columns: minmax(13rem, 17rem) minmax(13rem, 17rem) 1fr;
		gap: var(--space-6);
		align-items: center;
	}

	.scene {
		width: 100%;
		height: auto;
		border-radius: var(--radius-md);
	}

	.scene-figure {
		margin: 0;
	}

	.scene-caption {
		margin-top: var(--space-2);
		text-align: center;
		font-size: var(--text-xs);
		font-family: var(--font-mono);
		color: var(--color-text-faint);
		letter-spacing: 0.06em;
	}

	.scene-base {
		opacity: 0.85;
	}

	/* Scene parts */
	.sky {
		fill: var(--color-bg-overlay);
		transition: fill var(--duration-normal) var(--ease-out);
	}

	/* Background highlight: tint the whole sky so "background" is visible */
	.sky-highlighted {
		fill: color-mix(in srgb, var(--color-negative) 18%, var(--color-bg-overlay));
	}

	.moon {
		fill: var(--color-neutral);
		opacity: 0.5;
		transition: fill var(--duration-normal) var(--ease-out),
			opacity var(--duration-normal) var(--ease-out);
	}

	.moon-used {
		fill: var(--color-model);
		opacity: 0.95;
	}

	.moon-highlighted {
		fill: var(--color-negative);
		opacity: 0.9;
		stroke: var(--color-negative);
		stroke-width: 2.5;
	}

	.ground {
		fill: var(--color-neutral);
		opacity: 0.22;
	}

	.animal {
		fill: var(--color-neutral);
		opacity: 0.55;
	}

	.animal-used {
		fill: var(--color-model);
		opacity: 0.95;
	}

	.animal-highlighted {
		fill: var(--color-positive);
		opacity: 0.95;
	}

	/* ---- Story column ---- */
	.prediction {
		font-size: var(--text-lg);
		color: var(--color-text-muted);
	}

	.prediction strong {
		color: var(--color-text);
	}

	.explanation {
		margin-top: var(--space-2);
		font-style: italic;
		font-size: var(--text-lg);
	}

	.facts {
		margin-top: var(--space-6);
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-4);
	}

	.facts dt {
		color: var(--color-text-faint);
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	.facts dd {
		margin: var(--space-1) 0 0;
		font-weight: 600;
	}

	.facts .used {
		color: var(--color-model);
	}

	.facts .highlighted {
		color: var(--color-positive);
	}

	.summary {
		margin-top: var(--space-6);
		color: var(--color-text-muted);
	}

	.chips {
		margin-top: var(--space-4);
		padding: 0;
		list-style: none;
		display: flex;
		gap: var(--space-2);
		flex-wrap: wrap;
	}

	.chips li {
		font-size: var(--text-xs);
		font-family: var(--font-mono);
		padding: 2px 10px;
		border-radius: 999px;
		border: 1px solid var(--color-border);
		color: var(--color-text-muted);
	}

	.chips li.yes {
		border-color: var(--color-positive);
		color: var(--color-positive);
	}

	.chips li.no {
		border-color: var(--color-negative);
		color: var(--color-negative);
	}

	/* ---- Controls ---- */
	.controls {
		margin-top: var(--space-6);
		display: flex;
		align-items: center;
		justify-content: center;
		gap: var(--space-6);
	}

	.nav-btn {
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 50%;
		border: 1px solid var(--color-border);
		background: var(--color-bg-raised);
		color: var(--color-text);
		font-size: var(--text-lg);
		cursor: pointer;
		transition: border-color var(--duration-fast) var(--ease-out),
			transform var(--duration-fast) var(--ease-out);
	}

	.nav-btn:hover {
		border-color: var(--color-model);
		transform: scale(1.08);
	}

	.dots {
		display: flex;
		gap: var(--space-3);
	}

	.dot-btn {
		width: 12px;
		height: 12px;
		padding: 0;
		border-radius: 50%;
		border: none;
		background: var(--color-border);
		cursor: pointer;
		transition: background var(--duration-fast) var(--ease-out),
			transform var(--duration-fast) var(--ease-out);
	}

	.dot-btn:hover {
		transform: scale(1.3);
	}

	.dot-btn.active {
		background: var(--color-model);
		transform: scale(1.3);
	}

	.counter {
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		color: var(--color-text-faint);
		min-width: 3.5rem;
	}

	/* ---- Mobile ---- */
	@media (max-width: 800px) {
		.body {
			grid-template-columns: 1fr;
		}

		.scene-base {
			display: none; /* on small screens show only the annotated scene */
		}

		.facts {
			grid-template-columns: 1fr;
		}
	}
</style>

<script src="../scripts/archetype.ts"></script>
