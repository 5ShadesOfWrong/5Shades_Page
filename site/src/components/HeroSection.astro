---
/**
 * HeroSection.astro — §0 Hero (DESIGN_PLAN §4)
 * --------------------------------------------
 * Title "Explanation Wrongness" (user decision, 2026-10-19), the paper's
 * subtitle as the hook question, and the paper reference.
 *
 * Content comes from site.json (single source of truth).
 * Security: static data from a typed JSON import; auto-escaped by Astro.
 */
import site from '../data/site.json';
import PipelineFlow from './PipelineFlow.astro';
---

<section id="hero" class="section hero" aria-labelledby="hero-title">
	<div class="container hero-grid">
		<div class="hero-copy">
			<p class="kicker" data-reveal>{site.kicker}</p>
			<h1 id="hero-title" data-reveal data-reveal-delay="1">{site.title}</h1>
			<p class="lede" data-reveal data-reveal-delay="2">{site.subtitle}</p>

			<p class="deck-ref" data-reveal data-reveal-delay="3">
				Based on the paper: {site.paper.title}
			</p>

			<p class="tagline" data-reveal data-reveal-delay="4">{site.tagline.reader}</p>
		</div>

		<div class="hero-visual" data-reveal data-reveal-delay="3">
			<PipelineFlow />
		</div>
	</div>
</section>

<style>
	.hero {
		min-height: 92vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		position: relative;
	}

	/* Stacked hero: copy on top (centered), full-width diagram below.
	   The PipelineFlow needs horizontal room for its callout boxes. */
	.hero-grid {
		display: grid;
		gap: var(--space-12);
		width: 100%;
	}

	.hero-copy {
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.kicker {
		color: var(--color-model);
		font-size: var(--text-sm);
		text-transform: uppercase;
		letter-spacing: 0.14em;
		font-weight: 600;
	}

	h1 {
		font-size: clamp(2.75rem, 6vw, 4.5rem);
		margin-top: var(--space-4);
		color: var(--color-text);
		line-height: 1.05;
		letter-spacing: -0.02em;
	}

	.lede {
		margin-top: var(--space-6);
		font-size: var(--text-2xl);
		color: var(--color-text-muted);
		max-width: 30ch;
		line-height: 1.35;
	}

	.deck-ref {
		margin-top: var(--space-6);
		font-family: var(--font-mono);
		font-size: var(--text-sm);
		color: var(--color-text-faint);
		max-width: 44ch;
	}

	.tagline {
		margin-top: var(--space-8);
		color: var(--color-text-faint);
		font-size: var(--text-sm);
	}

	/* ---- Full-width diagram below the copy ---- */
	.hero-visual {
		width: 100%;
	}

	/* ---- Mobile: stack, diagram below copy ---- */
	@media (max-width: 900px) {
		.hero-grid {
			gap: var(--space-8);
		}
	}
</style>
