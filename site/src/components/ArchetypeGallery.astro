---
/**
 * ArchetypeGallery.astro — §3 The 5(0) Shades of Wrong (DESIGN_PLAN §4)
 * ----------------------------------------------------------------------
 * Grid of the six archetypes (a)–(f) from archetypes.json, each rendered as
 * a card with the paper's husky/wolf mini-story and C/V/F verdict chips.
 * Includes the paper's color legend (purple = used, green/red = highlighted).
 *
 * Visuals: abstract placeholder glyph per archetype (Phase 3 can replace with
 * recreated husky/wolf SVGs — open decision #3).
 *
 * Security: typed JSON data, auto-escaped.
 */
import archetypes from '../data/archetypes.json';
import type { Archetype, ArchetypesData } from '../schemas/schemas';

const data = archetypes as unknown as ArchetypesData;
const list = data.archetypes;
const legend = data.legend;

const verdictChip = (ok: boolean) => (ok ? 'yes' : 'no');
---

<section id="archetypes" class="section" aria-labelledby="archetypes-title">
	<div class="container">
		<h2 id="archetypes-title">The 5(0) Shades of Wrong</h2>
		<p class="intro">
			Combining the three lenses yields six archetypes: the perfect explainer
			(a) — and the five shades of wrong (b–f).
		</p>

		<ul class="legend" aria-label="Color legend from the paper">
			{
				Object.values(legend).map((item) => (
					<li>
						<span class="swatch" style={`background: ${item.color}`} aria-hidden="true" />
						{item.label}
					</li>
				))
			}
		</ul>

		<div class="gallery">
			{
				list.map((a) => (
					<article class:list={['archetype', { correct: a.verdict === 'correct' }]} id={`archetype-${a.id}`}>
						<header>
							<span class="letter" aria-hidden="true">({a.letter})</span>
							<h3>{a.name}</h3>
						</header>

						<div class="story" aria-hidden="true">
							<div class="frame">
								<span class="moon" />
								<span class="ground" />
							</div>
							<p class="prediction">
								Prediction: <strong>{a.prediction}</strong>
							</p>
							<p class="explanation">“{a.explanation}”</p>
						</div>

						<p class="summary">{a.summary}</p>

						<dl class="facts">
							<div>
								<dt>Model actually used</dt>
								<dd>{a.modelUsed}</dd>
							</div>
							<div>
								<dt>Explanation highlighted</dt>
								<dd>{a.highlighted}</dd>
							</div>
						</dl>

						<ul class="chips" aria-label={`${a.name} verdicts`}>
							<li class:list={[verdictChip(a.coherent)]}>Coherent</li>
							<li class:list={[verdictChip(a.valid)]}>Valid</li>
							<li class:list={[verdictChip(a.faithful)]}>Faithful</li>
						</ul>
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.intro {
		margin-top: var(--space-4);
		font-size: var(--text-lg);
		color: var(--color-text-muted);
		max-width: 52ch;
	}

	/* ---- Paper legend ---- */
	.legend {
		margin-top: var(--space-6);
		padding: 0;
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}

	.legend li {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
	}

	.swatch {
		width: 12px;
		height: 12px;
		border-radius: 3px;
		display: inline-block;
	}

	/* ---- Gallery grid ---- */
	.gallery {
		margin-top: var(--space-8);
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
		gap: var(--space-6);
	}

	.archetype {
		background: var(--color-bg-raised);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--space-6);
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.archetype.correct {
		border-color: color-mix(in srgb, var(--color-positive) 55%, var(--color-border));
	}

	.archetype header {
		display: flex;
		align-items: baseline;
		gap: var(--space-2);
	}

	.letter {
		font-family: var(--font-mono);
		color: var(--color-model);
	}

	/* ---- Abstract placeholder visual (husky/wolf scene) ---- */
	.story .frame {
		position: relative;
		height: 5.5rem;
		border-radius: var(--radius-md);
		background: linear-gradient(180deg, #1c2436 0%, #141a28 100%);
		border: 1px solid var(--color-border);
		overflow: hidden;
	}

	.moon {
		position: absolute;
		top: 18%;
		right: 22%;
		width: 22px;
		height: 22px;
		border-radius: 50%;
		background: var(--color-model);
		opacity: 0.85;
	}

	.ground {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		height: 26%;
		background: var(--color-neutral);
		opacity: 0.25;
	}

	.prediction {
		margin-top: var(--space-2);
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}

	.explanation {
		font-style: italic;
		font-size: var(--text-sm);
	}

	.summary {
		color: var(--color-text-muted);
		font-size: var(--text-sm);
	}

	/* ---- Facts + verdict chips ---- */
	.facts {
		display: grid;
		gap: var(--space-2);
		font-size: var(--text-sm);
	}

	.facts dt {
		color: var(--color-text-faint);
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	.facts dd {
		margin: 0;
	}

	.chips {
		margin-top: auto;
		padding: 0;
		list-style: none;
		display: flex;
		gap: var(--space-2);
		flex-wrap: wrap;
	}

	.chips li {
		font-size: var(--text-xs);
		font-family: var(--font-mono);
		padding: 2px 10px;
		border-radius: 999px;
		border: 1px solid var(--color-border);
		color: var(--color-text-muted);
	}

	.chips li.yes {
		border-color: var(--color-positive);
		color: var(--color-positive);
	}

	.chips li.no {
		border-color: var(--color-negative);
		color: var(--color-negative);
	}
</style>
