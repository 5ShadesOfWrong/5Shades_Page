---
/**
 * NavRail.astro — fixed section navigation (desktop) / progress bar (mobile)
 * --------------------------------------------------------------------------
 * Desktop: slim right-hand rail with one dot per section; active dot follows
 * scroll (scroll-spy in navrail.ts). Mobile: top progress bar.
 *
 * The section list is passed as a prop (single source of truth = index.astro
 * registry) so the rail can never drift out of sync with the page.
 *
 * Accessibility: nav landmark + aria-label; dots are real links (keyboard
 * navigable); aria-current marks the active section.
 */
export interface SectionRef {
	id: string;
	label: string;
}

interface Props {
	sections: readonly SectionRef[];
}

const { sections } = Astro.props;
---

<nav class="navrail" aria-label="Page sections">
	<!-- Mobile progress bar -->
	<div class="navrail-progress" aria-hidden="true">
		<div class="navrail-progress-fill" data-navrail-progress></div>
	</div>

	<!-- Desktop dots -->
	<ul class="navrail-dots">
		{
			sections.map((section) => (
				<li>
					<a href={`#${section.id}`} data-navrail-dot aria-label={section.label}>
						<span class="dot" aria-hidden="true" />
						<span class="label">{section.label}</span>
					</a>
				</li>
			))
		}
	</ul>
</nav>

<style>
	.navrail {
		position: fixed;
		inset-block: 0;
		right: 0;
		width: var(--navrail-width);
		display: flex;
		align-items: center;
		justify-content: center;
		z-index: 50;
		pointer-events: none; /* container transparent; links re-enable */
	}

	/* ---- Desktop dots ---- */
	.navrail-dots {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		pointer-events: auto;
	}

	.navrail-dots a {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		text-decoration: none;
		padding: var(--space-1);
	}

	.dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--color-border);
		transition: background var(--duration-fast) var(--ease-out),
			transform var(--duration-fast) var(--ease-out);
	}

	.navrail-dots a:hover .dot,
	.navrail-dots a[aria-current='true'] .dot {
		background: var(--color-model);
		transform: scale(1.35);
	}

	.label {
		font-size: var(--text-xs);
		color: var(--color-text-muted);
		opacity: 0;
		transform: translateX(4px);
		transition: opacity var(--duration-fast) var(--ease-out),
			transform var(--duration-fast) var(--ease-out);
		white-space: nowrap;
	}

	.navrail-dots a:hover .label,
	.navrail-dots a:focus-visible .label {
		opacity: 1;
		transform: translateX(0);
	}

	/* ---- Mobile: top progress bar, dots hidden ---- */
	.navrail-progress {
		display: none;
	}

	@media (max-width: 768px) {
		.navrail {
			inset-block: auto;
			top: 0;
			right: 0;
			left: 0;
			width: 100%;
			height: 3px;
			align-items: flex-start;
		}

		.navrail-dots {
			display: none;
		}

		.navrail-progress {
			display: block;
			width: 100%;
			height: 3px;
			background: var(--color-border);
		}

		.navrail-progress-fill {
			height: 100%;
			width: 0%;
			background: var(--color-model);
			transition: width 80ms linear;
		}
	}
</style>

<script src="../scripts/navrail.ts"></script>
