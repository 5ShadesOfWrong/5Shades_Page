---
/**
 * SiteFooter.astro — §7 footer (DESIGN_PLAN §4)
 * ---------------------------------------------
 * Citation block with copy-BibTeX button, paper PDF link, authors, license,
 * contact. The copy action is handled by bibtex.ts (clipboard API only).
 *
 * Security: static content; the BibTeX string is rendered as text content
 * (auto-escaped), never as HTML.
 */
import site from '../data/site.json';

// BASE_URL keeps the link correct when GitHub Pages serves from a subpath.
const paperHref = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${site.paper.file.replace(/^\//, '')}`;

// Partner logos (site/public/logos/). Alt text is required — update the
// names here if the logo set changes. joinBase keeps them subpath-safe.
const logos = [
	{ file: 'logos/logo1.png', alt: 'Carnegie Mellon University' },
	{ file: 'logos/logo2.png', alt: 'IAB — Institut für Arbeitsmarkt und Berufsforschung' },
	{ file: 'logos/logo3.png', alt: 'Universität Bayreuth' },
	{ file: 'logos/logo4.png', alt: 'ARC — Applied Research Center' },
	{ file: 'logos/logo5.png', alt: 'XITASO' },
	{ file: 'logos/logo6.png', alt: 'Karlsruhe Institute of Technology' },
];

/**
 * Join a public/ path with the configured base URL.
 * BUGFIX (2026-10-21): string concatenation produced '/shade-pagelogos/…'
 * because `base` has no trailing slash — the logos 404'd. This normalizes
 * the slashes on both sides.
 */
function joinBase(file: string): string {
	const base = import.meta.env.BASE_URL.endsWith('/')
		? import.meta.env.BASE_URL
		: `${import.meta.env.BASE_URL}/`;
	return `${base}${file.replace(/^\//, '')}`;
}
---

<footer id="footer" class="section footer" aria-labelledby="footer-title">
	<div class="container">
		<h2 id="footer-title" data-reveal>Cite & Explore</h2>

		<!-- Partner logos -->
		<div class="logo-strip" data-reveal aria-label="Partner institutions">
			{
				logos.map((logo) => (
					<img
						src={joinBase(logo.file)}
						alt={logo.alt}
						loading="lazy"
						width="120"
						height="48"
					/>
				))
			}
		</div>

		<div class="footer-grid">
			<!-- Citation -->
			<div class="cite">
				<h3>Citation</h3>
				<p class="authors">{site.authors}</p>
				<p class="paper-title">{site.paper.title}</p>
				{
					site.paper.venue && <p class="paper-venue">{site.paper.venue}</p>
				}

				<details class="bibtex">
					<summary>BibTeX</summary>
					<pre data-bibtex-source>{site.bibtex}</pre>
					<button type="button" class="copy-btn" data-bibtex-copy>
						Copy BibTeX
					</button>
					<span class="copy-status" data-bibtex-status role="status" aria-live="polite"></span>
				</details>
			</div>

			<!-- Links -->
			<nav class="links" aria-label="Footer links">
				<h3>Links</h3>
				<ul>
					<!-- Commented per user review 2026-10-21 (re-enable when the paper
					     is published / a contact address exists):
					<li>
						{
							site.paper.file ? (
								<a href={paperHref} target="_blank" rel="noopener noreferrer">
									{site.paper.label}
								</a>
							) : (
								<span class="link-disabled" title="Paper link available at launch">
									{site.paper.label} (coming soon)
								</span>
							)
						}
					</li>
					-->
					<li><a href="#hero">Back to top</a></li>
					<!-- <li><a href={site.links.contact}>Contact the authors</a></li> -->
				</ul>
			</nav>
		</div>

		<p class="colophon">
			{site.title} — companion site · License: {site.license} · Built with{" "}
			<a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>
		</p>
	</div>
</footer>

<style>
	.footer {
		border-top: 1px solid var(--color-border);
		padding-block: var(--space-16);
	}

	.footer-grid {
		margin-top: var(--space-8);
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
		gap: var(--space-12);
	}

	h3 {
		font-size: var(--text-sm);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-faint);
	}

	/* ---- Partner logo strip ---- */
	/* Logos are shown exactly as authored — no filter, no card box
	   (user review 2026-10-21: colors/text must stay untouched). */
	.logo-strip {
		margin-top: var(--space-8);
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-10, 3rem);
	}

	.logo-strip img {
		height: 80px;
		width: auto;
		object-fit: contain;
		/* Light chip behind each logo so dark logo text stays readable —
		   tinted toward the page indigo so it blends with the theme. */
		background: color-mix(in srgb, white 90%, var(--color-bg));
		padding: 12px 20px;
		border-radius: var(--radius-md);
	}

	/* ---- Citation ---- */
	.authors {
		margin-top: var(--space-3);
		font-weight: 600;
	}

	.paper-title {
		color: var(--color-text-muted);
	}

	.paper-venue {
		color: var(--color-text-faint);
		font-size: var(--text-sm);
	}

	.link-disabled {
		color: var(--color-text-faint);
	}

	.bibtex {
		margin-top: var(--space-4);
	}

	.bibtex summary {
		cursor: pointer;
		color: var(--color-link);
		font-weight: 600;
	}

	.bibtex pre {
		margin-top: var(--space-3);
		padding: var(--space-4);
		background: var(--color-bg-overlay);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		font-size: var(--text-sm);
		overflow-x: auto;
		white-space: pre-wrap;
	}

	.copy-btn {
		margin-top: var(--space-3);
		padding: var(--space-2) var(--space-4);
		background: transparent;
		color: var(--color-link);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		font-size: var(--text-sm);
		cursor: pointer;
		transition: border-color var(--duration-fast) var(--ease-out);
	}

	.copy-btn:hover {
		border-color: var(--color-link);
	}

	.copy-status {
		margin-left: var(--space-3);
		font-size: var(--text-sm);
		color: var(--color-positive);
	}

	/* ---- Links ---- */
	.links ul {
		margin-top: var(--space-3);
		padding: 0;
		list-style: none;
		display: grid;
		gap: var(--space-2);
	}

	.colophon {
		margin-top: var(--space-16);
		padding-top: var(--space-6);
		border-top: 1px solid var(--color-border);
		color: var(--color-text-faint);
		font-size: var(--text-sm);
	}
</style>

<script src="../scripts/bibtex.ts"></script>
