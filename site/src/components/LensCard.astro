---
/**
 * LensCard.astro — one wrongness dimension (§2a–c)
 * -------------------------------------------------
 * Renders a single lens from lenses.json: definition, good vs. flawed
 * example, and the paper's facets of failure as an expandable list.
 *
 * Props: lens (typed by src/schemas/schemas.ts — single source of truth).
 * Security: all strings auto-escaped; facets rendered as list items, no HTML.
 */
import type { Lens } from '../schemas/schemas';

interface Props {
	lens: Lens;
}

const { lens } = Astro.props;
---

<article class="lens-card" id={`lens-${lens.id}`} aria-labelledby={`lens-${lens.id}-title`}>
	<header class="lens-head">
		<span class="lens-number" aria-hidden="true">{lens.number}</span>
		<div>
			<h3 id={`lens-${lens.id}-title`}>{lens.name}</h3>
			<p class="relationship">{lens.relationship}</p>
		</div>
	</header>

	<p class="definition">{lens.definition}</p>

	<div class="examples">
		<div class="example example-good">
			<h4>Coherent / valid / faithful</h4>
			<p class="example-setup">{lens.goodExample.setup}</p>
			<blockquote>{lens.goodExample.explanation}</blockquote>
			<p class="example-why">{lens.goodExample.why}</p>
		</div>

		<div class="example example-flawed">
			<h4>Where it breaks</h4>
			<p class="example-setup">{lens.flawedExample.setup}</p>
			<blockquote>{lens.flawedExample.explanation}</blockquote>
			<p class="example-why">{lens.flawedExample.why}</p>
		</div>
	</div>

	<details class="facets">
		<summary>
			Facets of failure
			<span class="facet-count">({lens.facets.length})</span>
		</summary>
		<ul>
			{
				lens.facets.map((facet) => (
					<li>
						<strong>{facet.name}:</strong> {facet.example}
					</li>
				))
			}
		</ul>
		<p class="footnote">{lens.footnote}</p>
	</details>
</article>

<style>
	.lens-card {
		background: var(--color-bg-raised);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--space-6);
		scroll-margin-top: var(--space-8);
	}

	.lens-card h3 {
		font-size: var(--text-xl);
	}

	.lens-head {
		display: flex;
		align-items: baseline;
		gap: var(--space-4);
	}

	.lens-number {
		font-family: var(--font-mono);
		font-size: var(--text-2xl);
		color: var(--color-model);
	}

	.relationship {
		color: var(--color-text-muted);
		font-size: var(--text-sm);
		margin-top: var(--space-1);
	}

	.definition {
		margin-top: var(--space-3);
		max-width: var(--measure);
	}

	/* ---- Examples stacked (cards sit in 3 columns — vertical space matters) ---- */
	.examples {
		margin-top: var(--space-4);
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-3);
	}

	.example {
		border-radius: var(--radius-md);
		padding: var(--space-3);
		border: 1px solid var(--color-border);
	}

	.example-good {
		border-color: color-mix(in srgb, var(--color-positive) 45%, var(--color-border));
	}

	.example-flawed {
		border-color: color-mix(in srgb, var(--color-negative) 45%, var(--color-border));
	}

	.example h4 {
		font-size: var(--text-xs);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-faint);
	}

	.example-setup {
		margin-top: var(--space-1);
		font-size: var(--text-sm);
		color: var(--color-text-muted);
	}

	.example blockquote {
		margin-top: var(--space-1);
		font-style: italic;
		font-size: var(--text-sm);
	}

	.example-why {
		margin-top: var(--space-1);
		font-size: var(--text-xs);
		color: var(--color-text-muted);
	}

	/* ---- Facets (progressive disclosure) ---- */
	.facets {
		margin-top: var(--space-4);
	}

	.facets summary {
		cursor: pointer;
		font-weight: 600;
		color: var(--color-link);
	}

	.facets summary:hover {
		text-decoration: underline;
	}

	.facet-count {
		color: var(--color-text-faint);
		font-weight: 400;
	}

	.facets ul {
		margin-top: var(--space-3);
		padding-left: var(--space-6);
		display: grid;
		gap: var(--space-2);
	}

	.footnote {
		margin-top: var(--space-3);
		font-size: var(--text-sm);
		color: var(--color-text-faint);
		font-style: italic;
	}
</style>
