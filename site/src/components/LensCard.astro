---
import './LensCard.css';
import type { Lens } from '../schemas/schemas';

/**
 * LensCard.astro — one wrongness dimension (§2a–c)
 * -------------------------------------------------
 * Renders a single lens from lenses.json: definition, good vs. flawed
 * example, and the paper's facets of failure as an expandable list.
 *
 * Props: lens (typed by src/schemas/schemas.ts — single source of truth).
 * Security: all strings auto-escaped; facets rendered as list items, no HTML.
 */

interface Props {
	lens: Lens;
}

const { lens } = Astro.props;

---

<article class="lens-card" id={`lens-${lens.id}`} aria-labelledby={`lens-${lens.id}-title`}>
	<header class="lens-head">
		<span class="lens-number" aria-hidden="true">{lens.number}</span>
		<div>
			<h3 id={`lens-${lens.id}-title`}>{lens.name}</h3>
			<p class="relationship">{lens.relationship}</p>
		</div>
	</header>

	<p class="definition">{lens.definition}</p>

	<div class="examples">
		<div class="example example-good">
			<h4>{lens.exampleHeaders.good}</h4>
			<p class="example-setup">{lens.goodExample.setup}</p>
			<blockquote>{lens.goodExample.explanation}</blockquote>
			<p class="example-why">{lens.goodExample.why}</p>
		</div>

		<div class="example example-flawed">
			<h4>{lens.exampleHeaders.flawed}</h4>
			<p class="example-setup">{lens.flawedExample.setup}</p>
			<blockquote>{lens.flawedExample.explanation}</blockquote>
			<p class="example-why">{lens.flawedExample.why}</p>
		</div>
	</div>

	<details class="facets">
		<summary>
			Facets of Wrongness
			<span class="facet-count">({lens.facets.length})</span>
		</summary>
		<ul>
			{
				lens.facets.map((facet) => (
					<li>
						<strong>{facet.name}:</strong> {facet.example}
					</li>
				))
			}
		</ul>
		<p class="footnote">{lens.footnote}</p>
	</details>
</article>


